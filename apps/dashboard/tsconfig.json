{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "allowJs": false,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@veridia/shared": ["../../packages/shared/src/index.ts"],
      "@veridia/security": ["../../packages/security/src/index.ts"],
      "@veridia/database": ["../../packages/database/src/index.ts"]
    }
  },
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    "instrumentation.ts",
    "sentry.*.config.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "**/* [0-9].ts",
    "**/* [0-9].tsx",
    "**/* [0-9][0-9].ts"
  ]
}
